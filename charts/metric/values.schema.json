{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metric Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "fullnameOverride",
    "replicaCount",
    "profile",
    "secrets",
    "service",
    "ingress",
    "http",
    "persistence",
    "blob",
    "mongodb",
    "symbolicator",
    "resources",
    "terminationGracePeriodSeconds",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "podSecurityContext",
    "config",
    "extraEnv"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253
          }
        }
      }
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "enum": [
        "min",
        "low",
        "medium",
        "high"
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host",
        "annotations",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hosts",
              "secretName"
            ],
            "properties": {
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              }
            }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secureCookies",
        "trustedProxies"
      ],
      "properties": {
        "secureCookies": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "accessModes",
        "annotations"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^$|^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        },
        "annotations": {
          "type": "object",
          "propertyNames": {
            "not": { "const": "helm.sh/resource-policy" }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "s3"
      ],
      "properties": {
        "backend": {
          "enum": [
            "local",
            "s3"
          ]
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "bucket",
            "forcePathStyle",
            "existingSecret",
            "sessionToken"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "sessionToken": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "database",
        "resources",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "database": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 63
        },
        "cacheSizeGB": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.256
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingClaim",
            "size",
            "annotations"
          ],
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "annotations": {
              "type": "object",
              "propertyNames": {
                "not": { "const": "helm.sh/resource-policy" }
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "symbolicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalEndpoint",
        "image",
        "resources",
        "cleanupResources",
        "cacheSize"
      ],
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "externalEndpoint": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "cleanupResources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "cacheSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 40,
      "maximum": 3600
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "checksum/config"
          ]
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsNonRoot",
        "runAsUser",
        "runAsGroup",
        "fsGroup",
        "fsGroupChangePolicy",
        "seccompProfile"
      ],
      "properties": {
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroupChangePolicy": {
          "enum": [
            "OnRootMismatch",
            "Always"
          ]
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "RuntimeDefault"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "role"
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "secretKeyRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                    "maxLength": 253
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optional": {
                    "type": "boolean"
                  }
                }
              },
              "configMapKeyRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                    "maxLength": 253
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optional": {
                    "type": "boolean"
                  }
                }
              },
              "fieldRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fieldPath"
                ],
                "properties": {
                  "fieldPath": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "valueFrom"
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9*]([a-z0-9.*-]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "blob": {
            "properties": {
              "backend": {
                "const": "s3"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "blob": {
            "properties": {
              "s3": {
                "properties": {
                  "bucket": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
