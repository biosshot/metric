# Copy to .env.local and keep the real file outside Git.
MONGODB_URI=mongodb://faultkeep:faultkeep-local-only@127.0.0.1:27018/faultkeep?authSource=admin
SCRUB_HMAC_KEY=replace_with_exactly_64_hexadecimal_characters

# Local HTTP only. Keep secure cookies enabled behind HTTPS.
APP__AUTH__SECURE_COOKIE=false
APP__DEVELOPMENT__ALLOW_INSECURE_COOKIES=true
