# Copy to .env in the same directory and replace both values.
# Use URL-safe letters/digits because the same value appears in the MongoDB URI.
METRIC_PROFILE=medium
COMPOSE_PROFILES=symbolication
METRIC_MONGO_PASSWORD=replace-with-a-long-url-safe-random-password
# Exactly 32 random bytes encoded as 64 lowercase hexadecimal characters.
METRIC_SCRUB_HMAC_KEY=replace-with-64-lowercase-hex-characters
METRIC_HTTP_PORT=4001
METRIC_IMAGE=ghcr.io/biosshot/metric:0.1.2
METRIC_SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.6.0
METRIC_MONGO_CACHE_GB=2
METRIC_MONGO_MEMORY_LIMIT=3g
METRIC_APP_MEMORY_LIMIT=1536m
METRIC_SYMBOLICATOR_MEMORY_LIMIT=2g
METRIC_CLEANUP_MEMORY_LIMIT=128m
METRIC_LOG_MAX_SIZE=25m
METRIC_LOG_MAX_FILES=4
