# Copy to a private file outside version control and replace both values.
# Use URL-safe letters/digits because the same value appears in the MongoDB URI.
FAULTKEEP_MONGO_PASSWORD=replace-with-a-long-url-safe-random-password
# Exactly 32 random bytes encoded as 64 lowercase hexadecimal characters.
FAULTKEEP_SCRUB_HMAC_KEY=replace-with-64-lowercase-hex-characters
FAULTKEEP_HTTP_PORT=4001
