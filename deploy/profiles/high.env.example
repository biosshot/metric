# High: 8 vCPU, 16 GiB RAM, 250 GiB SSD.
METRIC_PROFILE=high
COMPOSE_PROFILES=symbolication
METRIC_MONGO_PASSWORD=replace-with-a-long-url-safe-random-password
METRIC_SCRUB_HMAC_KEY=replace-with-64-lowercase-hex-characters
METRIC_HTTP_PORT=4001
METRIC_IMAGE=ghcr.io/biosshot/metric:0.1.2
METRIC_SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.6.0
METRIC_MONGO_CACHE_GB=5
METRIC_MONGO_MEMORY_LIMIT=6g
METRIC_APP_MEMORY_LIMIT=3g
METRIC_SYMBOLICATOR_MEMORY_LIMIT=4g
METRIC_CLEANUP_MEMORY_LIMIT=256m
METRIC_LOG_MAX_SIZE=50m
METRIC_LOG_MAX_FILES=5
