# Min: 1 vCPU, 1 GiB RAM, 15 GiB SSD. Symbolicator is not started.
METRIC_PROFILE=min
COMPOSE_PROFILES=
METRIC_MONGO_PASSWORD=replace-with-a-long-url-safe-random-password
METRIC_SCRUB_HMAC_KEY=replace-with-64-lowercase-hex-characters
METRIC_HTTP_PORT=4001
METRIC_IMAGE=ghcr.io/biosshot/metric:0.1.5
METRIC_SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:26.6.0
METRIC_MONGO_CACHE_GB=0.256
METRIC_MONGO_MEMORY_LIMIT=512m
METRIC_APP_MEMORY_LIMIT=320m
METRIC_SYMBOLICATOR_MEMORY_LIMIT=1g
METRIC_CLEANUP_MEMORY_LIMIT=128m
METRIC_LOG_MAX_SIZE=5m
METRIC_LOG_MAX_FILES=2
